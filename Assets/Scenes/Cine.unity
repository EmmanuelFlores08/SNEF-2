  triviaButton: {fileID: 1538533182}
  usarDatosDePrueba: 0
  triviaData:
    questions:
    - question: "\xBFQu\xE9 hacemos cuando ahorramos?"
      answers:
      - answerText: Guardamos una parte de nuestro dinero
        isCorrect: 1
        wrongJustification: 
      - answerText: Gastamos todo nuestro dinero
        isCorrect: 0
        wrongJustification: "Ahorrar significa reservar una parte del dinero para
          usarla despu\xE9s."
    - question: "\xBFQu\xE9 significa invertir nuestro dinero?"
      answers:
      - answerText: Guardar el dinero sin utilizarlo
        isCorrect: 0
        wrongJustification: Guardar dinero es ahorrar; invertir busca que pueda generar
          un rendimiento.
      - answerText: Poner el dinero a trabajar para que pueda crecer
        isCorrect: 1
        wrongJustification: 
    - question: "\xBFD\xF3nde podemos invertir nuestro dinero?"
      answers:
      - answerText: En un banco o en un negocio
        isCorrect: 1
        wrongJustification: 
      - answerText: Solo en una tienda para comprar cosas
        isCorrect: 0
        wrongJustification: "Una inversi\xF3n busca generar valor o rendimientos,
          no solo realizar una compra."
    - question: "\xBFQu\xE9 se necesita para emprender un negocio?"
      answers:
      - answerText: Solo tener dinero para comenzar
        isCorrect: 0
        wrongJustification: "Emprender tambi\xE9n requiere tiempo, trabajo y dedicaci\xF3n
          para desarrollar el negocio."
      - answerText: "Trabajo, tiempo y dedicaci\xF3n"
        isCorrect: 1
        wrongJustification: 
