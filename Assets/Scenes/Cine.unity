MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1800281526}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 59336a31478a2be44beee3fd3aab999a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  movieId: stp-cine-4
  movieTitle: "Misi\xF3n: Transferencia segura "
  videoClip: {fileID: 0}
  videoUrl: https://d22w9izyelikw7.cloudfront.net/content/stp-cine-4/v1/video.mp4
  triviaButton: {fileID: 568731482}
  usarDatosDePrueba: 0
  triviaData:
    questions:
    - question: "\xBFCu\xE1l es una se\xF1al com\xFAn de alerta en un posible fraude
        por mensaje?"
      answers:
      - answerText: El mensaje presiona para enviar dinero con urgencia
        isCorrect: 1
        wrongJustification: 
      - answerText: El remitente saluda antes de escribir
        isCorrect: 0
        wrongJustification: "Un saludo por s\xED solo, no indica fraude."
      - answerText: "El tel\xE9fono muestra la hora"
        isCorrect: 0
        wrongJustification: "La hora del tel\xE9fono no permite detectar un fraude."
      - answerText: "La conversaci\xF3n contiene una despedida"
        isCorrect: 0
        wrongJustification: "Una despedida es com\xFAn y no demuestra que haya fraude."
    - question: "Antes de autorizar una transferencia, \xBFQu\xE9 informaci\xF3n
        es indispensable revisar?"
      answers:
      - answerText: "El fondo de pantalla del tel\xE9fono"
        isCorrect: 0
        wrongJustification: "El fondo de pantalla no influye en la seguridad del
          env\xEDo."
      - answerText: "El nombre del destinatario y los datos de la operaci\xF3n"
        isCorrect: 1
        wrongJustification: 
      - answerText: La cantidad de aplicaciones instaladas
        isCorrect: 0
        wrongJustification: "Las aplicaciones instaladas no confirman a qui\xE9n
          env\xEDas."
      - answerText: "El nivel de bater\xEDa del dispositivo"
        isCorrect: 0
        wrongJustification: "La bater\xEDa no ayuda a verificar los datos de la operaci\xF3n."
    - question: "Si un familiar solicita dinero desde un n\xFAmero desconocido, \xBFQu\xE9
        conviene hacer?"
      answers:
      - answerText: "Transferir primero y confirmar despu\xE9s"
        isCorrect: 0
        wrongJustification: Enviar antes de confirmar puede hacerte perder dinero.
      - answerText: "Responder \xFAnicamente con datos bancarios"
        isCorrect: 0
        wrongJustification: Compartir datos sin verificar puede poner tu cuenta en
          riesgo.
      - answerText: "Contactarlo mediante un n\xFAmero o canal que ya se conoce."
        isCorrect: 1
        wrongJustification: 
      - answerText: "Compartir el mensaje con m\xE1s desconocidos"
        isCorrect: 0
        wrongJustification: Difundirlo no confirma la identidad y aumenta el riesgo.
    - question: "\xBFPor qu\xE9 nunca deben compartirse contrase\xF1as o c\xF3digos
        de verificaci\xF3n?"
      answers:
      - answerText: Porque permiten acceder a la cuenta o autorizar operaciones
        isCorrect: 1
        wrongJustification: 
      - answerText: "Porque hacen que el tel\xE9fono se apague"
        isCorrect: 0
        wrongJustification: "Los c\xF3digos protegen cuentas; no controlan el apagado."
      - answerText: Porque cambian el nombre del beneficiario
        isCorrect: 0
        wrongJustification: "Los c\xF3digos no cambian nombres; permiten autorizar
          acciones."
      - answerText: Porque impiden recibir mensajes
        isCorrect: 0
        wrongJustification: "Los c\xF3digos no bloquean mensajes; protegen el acceso."
  selectedBorder: {fileID: 394991873}
  animatedTarget: {fileID: 908401414}
  normalScale: 1
  hoverScale: 1.05
  hoverDuration: 0.12
  pressedScale: 0.94
  pressDuration: 0.08
  releaseDuration: 0.12
