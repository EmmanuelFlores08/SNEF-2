  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 59336a31478a2be44beee3fd3aab999a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  movieId: stp-cine-3
  movieTitle: "El futuro que est\xE1s escribiendo hoy"
  videoClip: {fileID: 0}
  videoUrl: https://d22w9izyelikw7.cloudfront.net/content/stp-cine-3/v1/video.mp4
  triviaButton: {fileID: 1547553997}
  usarDatosDePrueba: 0
  triviaData:
    questions:
    - question: "\xBFC\xF3mo influyen las decisiones financieras peque\xF1as y constantes?"
      answers:
      - answerText: Pueden acercar gradualmente a una persona a sus metas
        isCorrect: 1
        wrongJustification: 
      - answerText: No tienen efecto si no son decisiones perfectas
        isCorrect: 0
        wrongJustification: 'No hace falta ser perfecto: las buenas decisiones se
          acumulan.'
      - answerText: Solo sirven para objetivos de corto plazo
        isCorrect: 0
        wrongJustification: "Los pasos peque\xF1os tambi\xE9n impulsan metas de largo
          plazo."
      - answerText: Hacen innecesario revisar el presupuesto
        isCorrect: 0
        wrongJustification: Revisar el presupuesto permite ajustar el camino.
    - question: "\xBFQu\xE9 acciones fortalecen el camino hacia una meta financiera?"
      answers:
      - answerText: Planear, ahorrar y tomar decisiones informadas
        isCorrect: 1
        wrongJustification: 
      - answerText: Esperar sin revisar ingresos ni gastos
        isCorrect: 0
        wrongJustification: "Sin revisar tus recursos es dif\xEDcil avanzar con un
          plan."
      - answerText: "Gastar primero y definir metas despu\xE9s"
        isCorrect: 0
        wrongJustification: "Definir metas antes ayuda a decidir c\xF3mo usar el
          dinero."
      - answerText: "Cambiar de plan todos los d\xEDas"
        isCorrect: 0
        wrongJustification: Cambiar a diario dificulta mantener el rumbo hacia la
          meta.
    - question: "\xBFPor qu\xE9 es \xFAtil revisar peri\xF3dicamente un plan financiero?"
      answers:
      - answerText: Porque las metas y circunstancias pueden cambiar
        isCorrect: 1
        wrongJustification: 
      - answerText: Porque un presupuesto solo funciona una vez
        isCorrect: 0
        wrongJustification: Un presupuesto funciona mejor cuando se revisa y ajusta.
      - answerText: "Porque permite evitar cualquier decisi\xF3n"
        isCorrect: 0
        wrongJustification: Revisar el plan ayuda a decidir, no a evitar decisiones.
      - answerText: Porque obliga a gastar todos los ahorros
        isCorrect: 0
        wrongJustification: Revisar el plan protege el ahorro y permite hacer ajustes.
    - question: "\xBFQu\xE9 simbolizan las p\xE1ginas en blanco que recibe Sof\xEDa?"
      answers:
      - answerText: "Que su futuro ya est\xE1 decidido"
        isCorrect: 0
        wrongJustification: El futuro puede cambiar con las decisiones que tomes
          hoy.
      - answerText: Que sus metas anteriores dejaron de importar
        isCorrect: 0
        wrongJustification: "Las p\xE1ginas invitan a actuar, no a abandonar sus
          metas."
      - answerText: Que ya no necesita planear ni ahorrar
        isCorrect: 0
        wrongJustification: Planear y ahorrar le ayudan a escribir el futuro que
          desea.
      - answerText: Que puede construir su historia con decisiones cotidianas
        isCorrect: 1
        wrongJustification: 
