MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 838839729}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 59336a31478a2be44beee3fd3aab999a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  movieId: stp-cine-2
  movieTitle: La ruta digital hacia tu futuro
  videoClip: {fileID: 0}
  videoUrl: https://d22w9izyelikw7.cloudfront.net/content/stp-cine-2/v1/video.mp4
  triviaButton: {fileID: 1912763723}
  usarDatosDePrueba: 0
  triviaData:
    questions:
    - question: "\xBFPara qu\xE9 sirve elaborar un presupuesto personal?"
      answers:
      - answerText: Para conocer ingresos, gastos y capacidad de ahorro
        isCorrect: 1
        wrongJustification: 
      - answerText: "Para eliminar autom\xE1ticamente todos los gastos"
        isCorrect: 0
        wrongJustification: "Un presupuesto organiza gastos, no los elimina por s\xED
          solo."
      - answerText: "Para garantizar que nunca habr\xE1 imprevistos"
        isCorrect: 0
        wrongJustification: Un presupuesto ayuda a prepararte, pero no evita imprevistos.
      - answerText: Para sustituir todas las metas financieras
        isCorrect: 0
        wrongJustification: El presupuesto ayuda a cumplir metas, no a reemplazarlas.
    - question: "\xBFQu\xE9 ventaja tiene separar el dinero entre gastos, ahorro
        y metas?"
      answers:
      - answerText: "Permite asignar un prop\xF3sito a los ingresos"
        isCorrect: 1
        wrongJustification: 
      - answerText: "Evita tener que revisar cu\xE1nto se recibe "
        isCorrect: 0
        wrongJustification: Conocer tus ingresos es necesario para repartir el dinero.
      - answerText: Obliga a abandonar las metas de largo plazo
        isCorrect: 0
        wrongJustification: Separar el dinero permite avanzar en metas de varios
          plazos.
      - answerText: Hace innecesario ajustar el plan
        isCorrect: 0
        wrongJustification: El plan debe ajustarse cuando cambian ingresos o necesidades.
    - question: "\xBFEs posible ahorrar para metas de distintos plazos al mismo tiempo?"
      answers:
      - answerText: No, siempre debe elegirse una sola meta
        isCorrect: 0
        wrongJustification: Puedes ahorrar para varias metas si asignas dinero a
          cada una.
      - answerText: "S\xED, si se distribuye el ahorro de acuerdo con un plan"
        isCorrect: 1
        wrongJustification: 
      - answerText: Solo cuando todas las metas cuestan lo mismo
        isCorrect: 0
        wrongJustification: Las metas pueden tener costos y plazos diferentes.
      - answerText: "\xDAnicamente si no existen gastos cotidianos"
        isCorrect: 0
        wrongJustification: Puedes ahorrar y cubrir gastos si organizas tus ingresos.
    - question: "Al comenzar a ahorrar, \xBFQu\xE9 suele ser m\xE1s importante que
        iniciar con una gran cantidad?"
      answers:
      - answerText: Cambiar de objetivo con frecuencia
        isCorrect: 0
        wrongJustification: Cambiar seguido de objetivo dificulta avanzar con constancia.
      - answerText: Esperar el momento perfecto
        isCorrect: 0
        wrongJustification: Empezar con poco suele ser mejor que seguir esperando.
      - answerText: Mantener la constancia de las aportaciones
        isCorrect: 1
        wrongJustification: 
      - answerText: "Gastar primero y registrar despu\xE9s"
        isCorrect: 0
        wrongJustification: Registrar y planear antes ayuda a reservar dinero para
          ahorrar.
