MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1468437338}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 59336a31478a2be44beee3fd3aab999a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  movieId: stp-cine-1
  movieTitle: "Misi\xF3n: Salva a tu yo del futuro"
  videoClip: {fileID: 0}
  videoUrl: https://d22w9izyelikw7.cloudfront.net/content/stp-cine-1/v1/video.mp4
  triviaButton: {fileID: 893727999}
  usarDatosDePrueba: 0
  triviaData:
    questions:
    - question: "\xBFCu\xE1l es la funci\xF3n principal de un fondo de emergencia?"
      answers:
      - answerText: Cubrir gastos imprevistos sin desproteger otras metas
        isCorrect: 1
        wrongJustification: 
      - answerText: "Pagar \xFAnicamente compras planeadas"
        isCorrect: 0
        wrongJustification: Este fondo es para imprevistos, no para compras planeadas.
      - answerText: Sustituir para siempre el ahorro para el retiro
        isCorrect: 0
        wrongJustification: Emergencias y retiro son metas distintas, ahorra para
          ambas.
      - answerText: Evitar elaborar un presupuesto
        isCorrect: 0
        wrongJustification: El fondo complementa el presupuesto, no lo reemplaza.
    - question: "\xBFPor qu\xE9 conviene mantener separado el ahorro para el retiro?"
      answers:
      - answerText: Para proteger una meta de largo plazo de gastos inmediatos
        isCorrect: 1
        wrongJustification: 
      - answerText: Para gastarlo cuando aparezca cualquier oferta
        isCorrect: 0
        wrongJustification: Usarlo en ofertas aleja una meta pensada para el futuro.
      - answerText: "Para dejar de aportar despu\xE9s del primer ahorro"
        isCorrect: 0
        wrongJustification: El retiro se construye con aportaciones constantes.
      - answerText: "Para no registrar los dem\xE1s gastos"
        isCorrect: 0
        wrongJustification: Registrar gastos ayuda a cuidar todas tus metas.
    - question: "\xBFQu\xE9 ventaja puede tener comenzar a ahorrar para el retiro
        desde hoy?"
      answers:
      - answerText: "Da m\xE1s tiempo para construir la meta paso a paso"
        isCorrect: 1
        wrongJustification: 
      - answerText: Elimina la necesidad de tomar decisiones financieras
        isCorrect: 0
        wrongJustification: "Ahorrar temprano ayuda, pero a\xFAn debes tomar buenas
          decisiones."
      - answerText: Garantiza una cantidad fija sin importar las aportaciones
        isCorrect: 0
        wrongJustification: "El resultado depende de cu\xE1nto y con qu\xE9 constancia
          aportes."
      - answerText: Permite ignorar los gastos actuales
        isCorrect: 0
        wrongJustification: " Ahorrar para el futuro tambi\xE9n exige cuidar los
          gastos de hoy."
    - question: "\xBFQu\xE9 decisi\xF3n permite a Daniel completar su misi\xF3n?"
      answers:
      - answerText: Gastar todos sus ingresos de inmediato
        isCorrect: 0
        wrongJustification: Gastar todo impide prepararse para metas futuras
      - answerText: Disfrutar el presente y destinar una parte al ahorro futuro
        isCorrect: 1
        wrongJustification: 
      - answerText: Usar el ahorro para el retiro ante cualquier gasto
        isCorrect: 0
        wrongJustification: "Usarlo para gastos comunes reduce la protecci\xF3n del
          futuro"
      - answerText: "Posponer indefinidamente su planificaci\xF3n"
        isCorrect: 0
        wrongJustification: Posponer el plan deja menos tiempo para alcanzar la meta.
  selectedBorder: {fileID: 1105131485}
  animatedTarget: {fileID: 1997651579}
  normalScale: 1
  hoverScale: 1.05
  hoverDuration: 0.12
  pressedScale: 0.94
  pressDuration: 0.08
  releaseDuration: 0.12
