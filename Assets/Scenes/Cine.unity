  m_Script: {fileID: 11500000, guid: 59336a31478a2be44beee3fd3aab999a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  movieId: Clip-cine-4
  movieTitle: Operacion Segunda Sucursal
  videoClip: {fileID: 0}
  videoUrl: https://d22w9izyelikw7.cloudfront.net/content/stp-cine-4/v1/video.mp4
  triviaButton: {fileID: 1440908151}
  usarDatosDePrueba: 0
  triviaData:
    questions:
    - question: "\xBFCu\xE1l es la misi\xF3n de Valeria que requiere la adquisici\xF3n
        de equipo nuevo?"
      answers:
      - answerText: "Cambiar la decoraci\xF3n de su taller"
        isCorrect: 0
        wrongJustification: 'Incorrecto: Su objetivo es expandir su negocio a un
          local 2.'
      - answerText: Abrir una segunda sucursal de su negocio
        isCorrect: 1
        wrongJustification: 
      - answerText: Vender su maquinaria actual
        isCorrect: 0
        wrongJustification: 'Incorrecto: Necesita equipo nuevo para crecer, no para
          cerrar.'
      - answerText: Cerrar el taller actual para mudarse a otro lugar
        isCorrect: 0
        wrongJustification: "Incorrecta: el proyecto consiste en abrir una segunda
          sucursal y mantener la operaci\xF3n actual."
    - question: "\xBFQu\xE9 opci\xF3n riesgosa le propone su socio para conseguir
        el dinero r\xE1pido?"
      answers:
      - answerText: Vender las acciones del negocio
        isCorrect: 0
        wrongJustification: "Incorrecto: El socio le sugiere tomar un pr\xE9stamo
          informal."
      - answerText: "Tomar un pr\xE9stamo informal de la calle"
        isCorrect: 1
        wrongJustification: 
      - answerText: Pedir aportaciones a sus clientes
        isCorrect: 0
        wrongJustification: "Incorrecto: Le muestra un volante de cr\xE9ditos informales."
      - answerText: Pedir dinero a familiares sin establecer condiciones de pago
        isCorrect: 0
        wrongJustification: 'Incorrecta: esa alternativa no aparece en el guion;
          la propuesta concreta es un'
    - question: "\xBFPor qu\xE9 Valeria arruga y tira a la basura el volante del
        pr\xE9stamo informal?"
      answers:
      - answerText: Porque el volante estaba roto y sucio Incorrecto
        isCorrect: 0
        wrongJustification: "Lo rechaza porque esos cr\xE9ditos ponen en riesgo la
          empresa."
      - answerText: "Porque sabe que caer en la red informal da\xF1a el negocio"
        isCorrect: 1
        wrongJustification: 
      - answerText: "Porque el pr\xE9stamo ped\xEDa muchos requisitos"
        isCorrect: 0
        wrongJustification: 'Incorrecto: Al contrario, eran inmediatos pero con gran
          riesgo.'
      - answerText: Porque ya no necesitaba comprar el equipo
        isCorrect: 0
        wrongJustification: "Incorrecta: Valeria s\xED necesita el equipo; lo que
          rechaza es la forma riesgosa de financiarlo."
    - question: "\xBFQu\xE9 acci\xF3n previa le permiti\xF3 a Valeria obtener la
        aprobaci\xF3n del cr\xE9dito formal?"
      answers:
      - answerText: "Pedir cartas de recomendaci\xF3n a vecinos"
        isCorrect: 0
        wrongJustification: "Incorrecto: El cr\xE9dito se aprob\xF3 por bancarizar
          sus ventas."
      - answerText: Registrar y bancarizar sus ventas constantemente
        isCorrect: 1
        wrongJustification: 
      - answerText: Hipotecar su casa para el proyecto
        isCorrect: 0
        wrongJustification: 'Incorrecto: Su respaldo fue el historial financiero
          del negocio.'
      - answerText: "Presentar el volante del pr\xE9stamo informal como comprobante
          de ingreso"
        isCorrect: 0
        wrongJustification: El volante no demuestra la capacidad financiera del negocio
