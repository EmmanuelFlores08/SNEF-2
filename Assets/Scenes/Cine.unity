  movieId: Clip-cine-5
  movieTitle: Sobreviviendo a la Tormenta
  videoClip: {fileID: 0}
  videoUrl: https://d22w9izyelikw7.cloudfront.net/content/stp-cine-5/v1/video.mp4
  triviaButton: {fileID: 1091166199}
  usarDatosDePrueba: 0
  triviaData:
    questions:
    - question: "\xBFQu\xE9 dos imprevistos simult\xE1neos golpean el puesto de comida
        de Don Ram\xF3n?"
      answers:
      - answerText: Se acaba la comida y le roban la caja
        isCorrect: 0
        wrongJustification: Los imprevistos fueron la falla de equipo y la luz
      - answerText: Se rompe la parrilla y hay un corte de luz
        isCorrect: 1
        wrongJustification: 
    - question: "\xBFPor qu\xE9 Don Ram\xF3n no entra en quiebra ni en p\xE1nico
        ante la emergencia?"
      answers:
      - answerText: "Porque un cliente le regal\xF3 una parrilla"
        isCorrect: 1
        wrongJustification: 
      - answerText: "Porque pidi\xF3 un pr\xE9stamo urgente a un vecino"
        isCorrect: 0
        wrongJustification: "Incorrecto: \xC9l no necesit\xF3 endeudarse gracias
          a su ahorro."
    - question: "En el video, \xBFqu\xE9 h\xE1bito realizaba Don Ram\xF3n meses atr\xE1s
        para prepararse?"
      answers:
      - answerText: Guardaba un porcentaje de sus ingresos diarios
        isCorrect: 1
        wrongJustification: 
      - answerText: 'Compraba herramientas usadas en el tianguis '
        isCorrect: 0
        wrongJustification: "Incorrecto: El h\xE1bito mostrado fue destinar un ahorro
          constante."
    - question: "\xBFQu\xE9 ense\xF1anza transmite la c\xE1psula sobre los imprevistos
        en un negocio?"
      answers:
      - answerText: "Los imprevistos pueden evitarse por completo si se trabaja m\xE1s"
        isCorrect: 0
        wrongJustification: "Incorrecta: el guion dice que no se pueden evitar, pero
          s\xED prevenir financieramente."
      - answerText: Aprender a usar los medios de pago digitales con seguridad
        isCorrect: 1
        wrongJustification: Un fondo de emergencia ayuda a proteger el negocio ante
          reparaciones.
