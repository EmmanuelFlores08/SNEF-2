  triviaData:
    questions:
    - question: "\xBFCu\xE1les son las dos partes principales de un presupuesto?"
      answers:
      - answerText: Compras y deseos
        isCorrect: 0
        wrongJustification: Un presupuesto organiza el dinero que recibes y el que
          planeas gastar.
      - answerText: Ingresos y gastos
        isCorrect: 1
        wrongJustification: 
    - question: "\xBFQu\xE9 son los ingresos en un presupuesto?"
      answers:
      - answerText: El dinero que recibes
        isCorrect: 1
        wrongJustification: 
      - answerText: El dinero que planeas gastar
        isCorrect: 0
        wrongJustification: Los gastos son el dinero que planeas usar para cubrir
          diferentes necesidades.
    - question: "\xBFCu\xE1l es un ejemplo de gasto fijo para Chiwa?"
      answers:
      - answerText: Su comida y agua
        isCorrect: 1
        wrongJustification: 
      - answerText: "Un ba\xF1o y una sesi\xF3n de est\xE9tica"
        isCorrect: 0
        wrongJustification: "El ba\xF1o y la est\xE9tica son gastos que pueden presentarse
          solo algunas veces."
    - question: "\xBFCu\xE1l es un ejemplo de gasto variable para Chiwa?"
      answers:
      - answerText: Su comida
        isCorrect: 0
        wrongJustification: La comida es un gasto necesario que forma parte de sus
          gastos fijos.
      - answerText: "Un ba\xF1o y una sesi\xF3n de est\xE9tica"
        isCorrect: 1
        wrongJustification: 
