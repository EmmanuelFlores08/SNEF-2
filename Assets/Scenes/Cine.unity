  movieId: BancoAzteca-cine-1
  movieTitle: El dinero perdido de Regi
  videoClip: {fileID: 0}
  videoUrl: https://d22w9izyelikw7.cloudfront.net/content/stp-cine-1/v1/video.mp4
  triviaButton: {fileID: 946645718}
  usarDatosDePrueba: 0
  triviaData:
    questions:
    - question: "\xBFQu\xE9 hizo Regi con una parte del dinero que recibi\xF3?"
      answers:
      - answerText: "Lo gast\xF3 en varias cosas y antojos"
        isCorrect: 1
        wrongJustification: 
      - answerText: "Lo guard\xF3 todo en su alcanc\xEDa"
        isCorrect: 0
        wrongJustification: "Regi s\xED gast\xF3 parte de su dinero; no lo guard\xF3
          todo."
    - question: "\xBFQu\xE9 problema tuvo Regi al gastar su dinero?"
      answers:
      - answerText: "No sab\xEDa cu\xE1nto dinero ten\xEDa"
        isCorrect: 1
        wrongJustification: 
      - answerText: "No sab\xEDa cu\xE1nto costaban las cosas"
        isCorrect: 0
        wrongJustification: "Saber los precios ayuda, pero tambi\xE9n necesitas conocer
          tu dinero disponible."
    - question: "\xBFQu\xE9 debes hacer primero para decidir mejor en qu\xE9 gastar?"
      answers:
      - answerText: "Comprar primero lo que m\xE1s le guste"
        isCorrect: 0
        wrongJustification: Comprar solo por gusto puede hacer que gastes sin pensar
          en tu dinero.
      - answerText: "Saber cu\xE1nto dinero tiene"
        isCorrect: 1
        wrongJustification: 
    - question: "\xBFQu\xE9 necesitas para hacer un plan de ahorro?"
      answers:
      - answerText: "Solo saber cu\xE1nto cuesta lo que quieres"
        isCorrect: 0
        wrongJustification: "Saber el costo ayuda, pero tambi\xE9n necesitas definir
          cu\xE1nto ahorrar y por cu\xE1nto tiempo."
      - answerText: El costo de la meta, el dinero que puedes ahorrar y el tiempo
        isCorrect: 1
        wrongJustification: 
