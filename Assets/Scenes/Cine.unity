  m_Script: {fileID: 11500000, guid: 59336a31478a2be44beee3fd3aab999a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  movieId: Clip-cine-2
  movieTitle: Alta Demanda
  videoClip: {fileID: 0}
  videoUrl: s3://dev-snef2026-sponsorsplatform-assets/sponsors/paula.vasquez@payclip.com/contenidos/cine-2/video.mp4
  triviaButton: {fileID: 128266832}
  usarDatosDePrueba: 0
  triviaData:
    questions:
    - question: "\xBFQu\xE9 evento provoc\xF3 la llegada masiva e inesperada de clientes
        al restaurante de Adriana?"
      answers:
      - answerText: "La visita de un cr\xEDtico de comida"
        isCorrect: 0
        wrongJustification: "El motivo fue la finalizaci\xF3n de un evento masivo."
      - answerText: El cierre de un evento masivo en la plaza
        isCorrect: 1
        wrongJustification: 
      - answerText: Una oferta de platillos al dos por uno
        isCorrect: 0
        wrongJustification: La alta demanda fue externa y repentina.
      - answerText: Una fiesta privada organizada por Adriana
        isCorrect: 0
        wrongJustification: Entraron clientes de golpe tras el evento cercano.
    - question: "Ante el riesgo de quedarse sin insumos, \xBFqu\xE9 propuesta de
        p\xE1nico hace el ayudante?"
      answers:
      - answerText: Cerrar el restaurante inmediatamente
        isCorrect: 0
        wrongJustification: El ayudante sugiere comprar sin control a lo que sea.
      - answerText: "Hacer compras de p\xE1nico a cualquier precio"
        isCorrect: 1
        wrongJustification: 
      - answerText: "Cancelar las \xF3rdenes de los clientes"
        isCorrect: 0
        wrongJustification: Su idea era salir a comprar insumos a ciegas.
      - answerText: "Subir el precio del men\xFA en ese instante"
        isCorrect: 0
        wrongJustification: La propuesta fue hacer compras desesperadas.
    - question: "\xBFC\xF3mo logra Adriana \"congelar el tiempo\" y tomar el control
        del desorden en su cocina?"
      answers:
      - answerText: Pidiendo a los clientes que esperen fuera
        isCorrect: 0
        wrongJustification: "Mario actu\xF3 revisando su registro y presupuesto."
      - answerText: Revisando su flujo de caja y presupuestando
        isCorrect: 1
        wrongJustification: 
      - answerText: "Solicitando un cr\xE9dito expr\xE9s por tel\xE9fono"
        isCorrect: 0
        wrongJustification: "Utiliz\xF3 su registro de ingresos para priorizar."
      - answerText: "Cambiando el men\xFA por platillos fr\xEDos"
        isCorrect: 0
        wrongJustification: "\xC9l presupuest\xF3 compras de insumos estrat\xE9gicos."
    - question: "\xBFQu\xE9 debe hacer un negocio durante un periodo de alta demanda
        para convertir las ventas en ganancias"
      answers:
      - answerText: Comprar todo lo disponible sin revisar el presupuesto
        isCorrect: 0
        wrongJustification: "Las compras de p\xE1nico pueden aumentar gastos y desordenar
          el flujo de caja."
      - answerText: Registrar ingresos, presupuestar compras y mantener el control
          del flu
        isCorrect: 0
        wrongJustification: 
