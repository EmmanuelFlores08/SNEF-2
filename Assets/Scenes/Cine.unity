  m_Script: {fileID: 11500000, guid: 59336a31478a2be44beee3fd3aab999a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  movieId: stp-cine-5
  movieTitle: "La B\xFAsqueda del Pago Digital Perfecto"
  videoClip: {fileID: 0}
  videoUrl: https://d22w9izyelikw7.cloudfront.net/content/stp-cine-5/v1/video.mp4
  triviaButton: {fileID: 79404277}
  usarDatosDePrueba: 0
  triviaData:
    questions:
    - question: "Al comprar en l\xEDnea, \xBFQu\xE9 ayuda a reconocer un sitio confiable?"
      answers:
      - answerText: Que tenga muchos anuncios y ventanas emergentes
        isCorrect: 0
        wrongJustification: "Muchos anuncios pueden ser una se\xF1al de poca confianza."
      - answerText: "Revisar la direcci\xF3n web y las se\xF1ales de seguridad del
          sitio"
        isCorrect: 1
        wrongJustification: 
      - answerText: "Que solicite m\xE1s datos de los necesarios"
        isCorrect: 0
        wrongJustification: "Pedir datos de m\xE1s aumenta el riesgo para tu informaci\xF3n."
      - answerText: Que prometa cualquier producto gratis
        isCorrect: 0
        wrongJustification: Una promesa llamativa no garantiza que el sitio sea seguro.
    - question: "\xBFPor qu\xE9 es preferible usar la aplicaci\xF3n oficial de una
        instituci\xF3n financiera?"
      answers:
      - answerText: Porque reduce el riesgo de ingresar datos en canales falsos.
        isCorrect: 1
        wrongJustification: 
      - answerText: "Porque elimina la necesidad de revisar la operaci\xF3n"
        isCorrect: 0
        wrongJustification: "A\xFAn en la app oficial, debes revisar antes de confirmar."
      - answerText: "Porque permite compartir contrase\xF1as"
        isCorrect: 0
        wrongJustification: "Las contrase\xF1as siempre deben mantenerse en privado."
      - answerText: "Porque garantiza que nunca habr\xE1 errores"
        isCorrect: 0
        wrongJustification: "Ninguna aplicaci\xF3n evita todos los errores, debes
          revisar los datos."
    - question: "\xBFQu\xE9 beneficio de seguridad ofrecen las actualizaciones del
        dispositivo?"
      answers:
      - answerText: "Hacen innecesarios los c\xF3digos de acceso"
        isCorrect: 0
        wrongJustification: Las actualizaciones no sustituyen tus claves de seguridad.
      - answerText: "Corrigen vulnerabilidades y mejoran la protecci\xF3n."
        isCorrect: 1
        wrongJustification: 
      - answerText: Permiten confiar en cualquier enlace
        isCorrect: 0
        wrongJustification: Actualizar no vuelve seguros todos los enlaces.
      - answerText: Evitan revisar al beneficiario
        isCorrect: 0
        wrongJustification: "Actualizar no sustituye la revisi\xF3n de quien recibir\xE1
          el pago"
    - question: "\xBFQu\xE9 representa el tesoro que encuentra Leo al final de su
        aventura?"
      answers:
      - answerText: La posibilidad de pagar sin tomar precauciones
        isCorrect: 0
        wrongJustification: Los pagos digitales siempre requieren medidas de seguridad.
      - answerText: Aprender a usar los medios de pago digitales con seguridad
        isCorrect: 1
        wrongJustification: 
      - answerText: "La obligaci\xF3n de elegir siempre el m\xE9todo m\xE1s r\xE1pido"
        isCorrect: 0
        wrongJustification: "La seguridad importa m\xE1s que elegir el m\xE9todo
          m\xE1s r\xE1pido."
      - answerText: "La eliminaci\xF3n de todas las medidas de protecci\xF3n"
        isCorrect: 0
        wrongJustification: Quitar protecciones aumenta el riesgo de fraude o robo.
