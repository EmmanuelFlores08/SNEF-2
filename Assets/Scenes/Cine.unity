  usarDatosDePrueba: 0
  triviaData:
    questions:
    - question: "\xBFC\xF3mo debe ser una contrase\xF1a segura?"
      answers:
      - answerText: Con tu nombre y fecha de nacimiento
        isCorrect: 0
        wrongJustification: "Esos datos pueden ser f\xE1ciles de descubrir y poner
          en riesgo tus cuentas."
      - answerText: "Con letras, n\xFAmeros y s\xEDmbolos"
        isCorrect: 1
        wrongJustification: 
    - question: "\xBFQu\xE9 debes hacer con tus datos personales en Internet?"
      answers:
      - answerText: Mantenerlos privados
        isCorrect: 1
        wrongJustification: 
      - answerText: Compartirlos con cualquier persona
        isCorrect: 0
        wrongJustification: Compartir datos personales puede poner en riesgo tu privacidad
          y seguridad.
    - question: "\xBFQu\xE9 puedes hacer si alguien te pide informaci\xF3n personal?"
      answers:
      - answerText: "Evitar dar la ind\xBFformaci\xF3n"
        isCorrect: 1
        wrongJustification: 
      - answerText: "Darle la informaci\xF3n para saber qu\xE9 quiere"
        isCorrect: 0
        wrongJustification: "Antes de compartir informaci\xF3n, busca ayuda de un
          adulto de confianza."
    - question: "\xBFQu\xE9 debes hacer si recibes un mensaje que te parece sospechoso?"
      answers:
      - answerText: "Pedir ayuda y reportar la situaci\xF3n"
        isCorrect: 1
        wrongJustification: 
      - answerText: "Responder para averiguar qui\xE9n lo envi\xF3"
        isCorrect: 0
        wrongJustification: Responder puede exponerte a riesgos; es mejor pedir ayuda
          antes de actuar.
