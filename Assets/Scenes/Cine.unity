  triviaButton: {fileID: 225577550}
  usarDatosDePrueba: 0
  triviaData:
    questions:
    - question: "\xBFQu\xE9 debe hacer Charly para dejar de mezclar su dinero personal
        con el del negocio?"
      answers:
      - answerText: Usar la caja del negocio solo cuando tenga una emergencia personal
        isCorrect: 0
        wrongJustification: "Incorrecta porque las emergencias personales tambi\xE9n
          pueden descapitalizar el negocio."
      - answerText: Separar las cuentas y asignarse un sueldo fijo
        isCorrect: 1
        wrongJustification: 
    - question: "\xBFQu\xE9 informaci\xF3n obtiene Charly al separar sus cuentas?"
      answers:
      - answerText: Sus utilidades reales y el dinero disponible para operar o crecer
        isCorrect: 1
        wrongJustification: 
      - answerText: "\xDAnicamente cu\xE1nto dinero tiene en efectivo ese d\xEDa"
        isCorrect: 0
        wrongJustification: "Incorrecta porque el efectivo de un d\xEDa no muestrapor
          s\xED solo la rentabilidad real del negocio"
    - question: "\xBFCu\xE1l es el h\xE1bito financiero saludable que debe mantener
        Charly?"
      answers:
      - answerText: Retirar dinero de la caja cada vez que lo necesite
        isCorrect: 0
        wrongJustification: Incorrecta porque los retiros constantes dificultan conocer
          las utilidades y pueden afectar el flujo
      - answerText: "Esperar a que sobre dinero para decidir cu\xE1nto llevarse"
        isCorrect: 0
        wrongJustification: ' Incorrecta porque no establece un monto claro ni permite
          planear los gastos personales.'
      - answerText: "Recibir un sueldo fijo y dejar el dinero del negocio para su
          operaci\xF3n"
        isCorrect: 1
        wrongJustification: 
    - question: "\xBFQu\xE9 logra Charly al asignarse un sueldo fijo y separar las
        cuentas?"
      answers:
      - answerText: "Sabe cu\xE1nto puede gastar personalmente y puede identificar
          las utilidad"
        isCorrect: 1
        wrongJustification: 
      - answerText: "Puede tomar dinero de la caja sin l\xEDmite"
        isCorrect: 0
        wrongJustification: "El prop\xF3sito de separar las cuentas es establecer
          l\xEDmites claros y proteger la operaci\xF3n."
