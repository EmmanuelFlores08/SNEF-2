  m_Script: {fileID: 11500000, guid: 59336a31478a2be44beee3fd3aab999a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  movieId: Clip-cine-1
  movieTitle: 'El drama del Efectivo '
  videoClip: {fileID: 0}
  videoUrl: s3://dev-snef2026-sponsorsplatform-assets/sponsors/paula.vasquez@payclip.com/contenidos/cine-1/video.mp4
  triviaButton: {fileID: 493959224}
  usarDatosDePrueba: 0
  triviaData:
    questions:
    - question: "\xBFQu\xE9 riesgo operativo causa depender \xFAnicamente de dinero
        en efectivo?"
      answers:
      - answerText: "P\xE9rdida de ventas por falta de cambio y otras opciones pago"
        isCorrect: 1
        wrongJustification: 
      - answerText: Hace que el WiFi de la tienda deje de funcionar
        isCorrect: 0
        wrongJustification: Porque la terminal ya tiene internet
      - answerText: "Provoca que las terminales de tarjeta se sobrecalienten y se
          aver\xEDen"
        isCorrect: 0
        wrongJustification: "Si solo aceptas efectivo, \xA1ni siquiera est\xE1s utilizando
          terminales de tarjeta!"
      - answerText: "Convierte accidentalmente el dinero f\xEDsico en Bitcoin"
        isCorrect: 0
        wrongJustification: "El efectivo f\xEDsico no puede transformarse m\xE1gicamente
          en criptomoneda digital"
    - question: "\xBFQu\xE9 beneficio principal ofrece cobrar con herramientas digitales?"
      answers:
      - answerText: "Elimina los costos de env\xEDo"
        isCorrect: 0
        wrongJustification: "Los pagos digitales solo gestionan la forma en que el
          cliente te paga. La empresa de mensajer\xEDa o pa"
      - answerText: Blinda las ganancias y reduce riesgos del efectivo
        isCorrect: 1
        wrongJustification: 
      - answerText: Proporciona suministros gratuitos para la tienda
        isCorrect: 0
        wrongJustification: "Las herramientas de pago simplemente procesan dinero.
          No generan m\xE1gicamente servilletas, granos de"
      - answerText: Hace innecesario registrar las ventas del negocio
        isCorrect: 0
        wrongJustification: Cobrar digitalmente ayuda a controlar las operaciones,
          pero el registro de ventas es neces
    - question: "\xBFQu\xE9 situaci\xF3n del guion muestra una dificultad de aceptar
        \xFAnicamente efectivo?"
      answers:
      - answerText: "Un cliente paga con su celular y Rosal\xEDa entrega el producto
          de inmediato"
        isCorrect: 1
        wrongJustification: 
      - answerText: Un cliente quiere pagar con su celular, pero termina entregando
          un billete
        isCorrect: 0
        wrongJustification: "Al inicio del guion Rosal\xEDa todav\xEDa no cuenta
          con una terminal."
      - answerText: "El proveedor aumenta el precio de las artesan\xEDas"
        isCorrect: 0
        wrongJustification: el problema presentado es la falta de opciones de pago
          y de cambio.
    - question: "\xBFCu\xE1l es el mensaje final de la c\xE1psula sobre la seguridad
        financiera del negocio?"
      answers:
      - answerText: "Mientras m\xE1s efectivo se guarde, mayor ser\xE1 el control
          del negocio."
        isCorrect: 1
        wrongJustification: 
      - answerText: Menos efectivo puede significar mayor control y tranquilidad
        isCorrect: 0
        wrongJustification: Las herramientas digitales reducen riesgos relacionados
          con el efectivo, pero no eliminan todos los
      - answerText: "La mejor soluci\xF3n es dejar de aceptar cualquier forma de
          pago"
        isCorrect: 0
        wrongJustification: "El mensaje propone aceptar m\xE1s formas de pago, no
          dejar de vender."
